# Extension signing key - private half of the pinned extension ID.
# Whoever holds this can publish an update Chrome accepts as ours.
applyflow-extension.pem

# Knowledge-graph output from the graphify skill. Regenerated on demand.
graphify-out/

# The dashboard, built and copied into the extension by
# extension/scripts/bundle-dashboard.mjs. Generated on every build.
extension/public/dashboard/
