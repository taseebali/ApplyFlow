# Local development only. Copy to `.env.local`, which is gitignored.
#
# This prefills the OpenRouter key field in DEV BUILDS ONLY so you do not have
# to re-paste it after clearing storage. It is compiled out of `npm run build`
# entirely - see lib/dev-prefill.ts and scripts/check-no-secrets.mjs.
#
# Never put a key anywhere that a release build can read.
WXT_OPENROUTER_KEY=
